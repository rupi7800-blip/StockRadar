# ============================================================
# STOCK RADAR — configurazione (copia in .env e compila)
# Tutte le chiavi restano SOLO sul server: non vengono mai inviate al browser.
# ============================================================

# --- Obbligatorie -------------------------------------------
# Password dell'area /admin (minimo 10 caratteri, usane una lunga e unica)
ADMIN_PASSWORD=

# --- Consigliate --------------------------------------------
# Segreto per firmare le sessioni admin (>= 32 caratteri casuali). Genera con:  openssl rand -hex 32
SESSION_SECRET=
# Contatto inserito nello User-Agent delle richieste (la SEC lo richiede per un uso regolare dei suoi feed)
CONTACT_EMAIL=
# Le quotazioni (Yahoo Finance, Stooq), i calendari (Nasdaq) e i tassi BCE NON richiedono chiavi.

# --- Intelligenza artificiale (almeno una per traduzioni/analisi AI) ---
# L'ordine di utilizzo e i modelli si scelgono da Admin → AI. Se un fornitore fallisce si passa al successivo.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey (piano gratuito disponibile)
GEMINI_API_KEY=
# https://console.groq.com/keys (piano gratuito disponibile)
GROQ_API_KEY=
# https://console.mistral.ai/api-keys (piano gratuito "Experiment")
MISTRAL_API_KEY=
# https://openrouter.ai/keys (alcuni modelli gratuiti)
OPENROUTER_API_KEY=
# es. http://localhost:11434 per modelli locali gratuiti
OLLAMA_URL=
# Budget mensile AI predefinito in USD (modificabile da Admin → AI)
AI_MONTHLY_BUDGET_USD=10

# --- Traduzione gratuita di ripiego (senza AI) -------------
# Con un indirizzo email la quota MyMemory sale da 5.000 a 50.000 caratteri/giorno
MYMEMORY_EMAIL=

# --- Integrazioni gratuite opzionali -----------------------
# https://fred.stlouisfed.org/docs/api/api_key.html (Fed Funds, inflazione e disoccupazione USA)
FRED_API_KEY=

# --- Notifiche push (facoltative: se vuote vengono generate e salvate nel DB) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tuo-indirizzo@example.com

# --- Scheduler esterno (facoltativo) -----------------------
# Serve solo se ospiti l'app dove i processi in background vengono sospesi.
# Chiamata: curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://tuo-dominio/api/cron
CRON_SECRET=
# Imposta a 1 per disattivare lo scheduler interno (se usi solo quello esterno)
DISABLE_SCHEDULER=

# --- Archivio ----------------------------------------------
# Percorso del database SQLite (default: ./data/stock-radar.db)
DATABASE_PATH=
# Giorni di conservazione delle notizie (0 = per sempre)
ARCHIVE_RETENTION_DAYS=0
